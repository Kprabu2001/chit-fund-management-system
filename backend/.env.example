# ==============================================================================
# Django Backend Environment — EXAMPLE TEMPLATE
# Copy to .env and fill in actual values. NEVER commit .env to git.
# ==============================================================================
SECRET_KEY=replace-with-a-50-character-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Frontend origins allowed to call this API (scheme+host, NO trailing slash, comma separated).
# Production: https://kd-chit.vercel.app      Local: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://kd-chit.vercel.app
CSRF_TRUSTED_ORIGINS=https://kd-chit.vercel.app
PORT=8000

# MySQL Database Configuration
DB_NAME=kd_chit
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
